{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "declaration": false,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@ui/*": ["./src/web/ui/*"],
      "@protocol/*": ["./src/web/protocol/*"],
      "@api/*": ["./src/api/*"]
    },
    "types": [
      "vite/client",
      "vitest/globals",
      "node",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "src/web/ui/**/*.ts",
    "src/web/ui/**/*.tsx",
    "src/web/ui/**/*.d.ts",
    "src/web/protocol/**/*.ts",
    "src/shared/**/*.ts",
    "src/api/auth/session.ts",
    "src/api/auth/session.constants.ts",
    "src/api/auth/dto/**/*.ts",
    "src/api/user/dto/**/*.ts",
    "test/vitest-browser-setup.ts"
  ],
  "exclude": ["node_modules", "dist", "src/web/host/**"]
}
