{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.tsx"],
  "exclude": ["**/*.spec.ts", "**/*.spec.tsx"]
}
