{
  "name": "archipielago",
  "version": "0.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @archipielago/core build && pnpm --filter @archipielago/vite build && pnpm --filter @archipielago/nestjs build && pnpm --filter @archipielago/example-nestjs build",
    "format": "prettier --write --no-error-on-unmatched-pattern \"examples/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,json}\" \"*.json\" \"*.md\" \"docs/**/*.md\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"examples/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,json}\" \"*.json\" \"*.md\" \"docs/**/*.md\"",
    "postinstall": "pnpm --filter @archipielago/core build && pnpm --filter @archipielago/vite build && pnpm --filter @archipielago/nestjs build",
    "prepare": "husky",
    "start": "pnpm --filter @archipielago/example-nestjs start",
    "start:dev": "pnpm --filter @archipielago/example-nestjs start:dev",
    "start:debug": "pnpm --filter @archipielago/example-nestjs start:debug",
    "start:prod": "pnpm --filter @archipielago/example-nestjs start:prod",
    "deploy": "pnpm --filter @archipielago/example-nestjs deploy",
    "lint": "oxlint --type-aware --deny-warnings packages/ examples/",
    "test": "pnpm --filter @archipielago/example-nestjs test",
    "test:watch": "pnpm --filter @archipielago/example-nestjs test:watch",
    "test:cov": "pnpm --filter @archipielago/example-nestjs test:cov",
    "test:debug": "pnpm --filter @archipielago/example-nestjs test:debug",
    "test:e2e": "pnpm --filter @archipielago/example-nestjs test:e2e",
    "scaffold:web-ui": "pnpm --filter @archipielago/example-nestjs scaffold:web-ui",
    "storybook": "pnpm --filter @archipielago/example-nestjs storybook",
    "build-storybook": "pnpm --filter @archipielago/example-nestjs build-storybook",
    "islands:sync": "pnpm --filter @archipielago/example-nestjs islands:sync"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.64.1",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=24.7.0"
  },
  "engineStrict": true,
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --type-aware --deny-warnings --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
