{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "import/extensions": [
      "error",
      "always",
      {
        "ignorePackages": true,
        "checkTypeImports": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        ".storybook/**/*.{ts,tsx}",
        "src/web/ui/**/*.{ts,tsx}",
        "packages/react/**/*.{ts,tsx}"
      ],
      "rules": {
        "import/extensions": [
          "error",
          "never",
          {
            "ignorePackages": true,
            "checkTypeImports": true,
            "pattern": {
              "scss": "always",
              "css": "always"
            }
          }
        ]
      }
    },
    {
      "files": ["packages/vite/**/*.{ts,tsx}"],
      "rules": {
        "import/extensions": [
          "error",
          "always",
          {
            "ignorePackages": true,
            "checkTypeImports": true
          }
        ]
      }
    }
  ],
  "env": {
    "node": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "coverage/**",
    "**/node_modules/**",
    "src/generated/**"
  ]
}
