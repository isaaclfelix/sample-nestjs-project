{
  "name": "@archipielago/example-nestjs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "islands:sync": "tsx scripts/sync-island-manifest.ts",
    "prebuild": "pnpm run islands:sync",
    "prelint": "pnpm run islands:sync",
    "pretest": "pnpm run islands:sync",
    "pretest:watch": "pnpm run islands:sync",
    "pretest:cov": "pnpm run islands:sync",
    "pretest:e2e": "pnpm run islands:sync",
    "pretest:debug": "pnpm run islands:sync",
    "prestart": "pnpm run islands:sync",
    "prestart:dev": "pnpm run islands:sync",
    "prestart:debug": "pnpm run islands:sync",
    "postinstall": "prisma generate && pnpm run islands:sync",
    "build": "prisma generate && nest build && tsc -p tsconfig.web.json --noEmit && vite build && vite build --ssr src/web/ui/runtime/ssr/entry-server.tsx --outDir dist/web-server",
    "deploy": "nest deploy",
    "start": "nest start --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:prod": "NODE_ENV=production node --env-file=.env dist/main",
    "lint": "oxlint --type-aware --deny-warnings src/ test/ scripts/",
    "test": "env -u PLAYWRIGHT_BROWSERS_PATH vitest run",
    "test:watch": "env -u PLAYWRIGHT_BROWSERS_PATH vitest",
    "test:cov": "env -u PLAYWRIGHT_BROWSERS_PATH vitest run --coverage",
    "test:debug": "env -u PLAYWRIGHT_BROWSERS_PATH vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "env -u PLAYWRIGHT_BROWSERS_PATH vitest run --config ./vitest.config.e2e.ts",
    "scaffold:web-ui": "tsx scripts/scaffold-web-ui.ts",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build"
  },
  "dependencies": {
    "@archipielago/core": "workspace:*",
    "@archipielago/nestjs": "workspace:*",
    "@archipielago/react": "workspace:*",
    "@archipielago/vite": "workspace:*",
    "@hookform/resolvers": "^6.0.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@storybook/react-vite": "^10.6.5",
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "^4.1.2",
    "bootstrap": "5.3.8",
    "doiuse": "^6.0.6",
    "dotenv": "^18.0.9",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "postcss-sort-media-queries": "^6.7.1",
    "prisma": "7.10.1",
    "sass-embedded": "^1.106.1",
    "source-map-support": "^0.5.21",
    "storybook": "^10.6.5",
    "supertest": "^7.0.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=24.7.0"
  }
}
